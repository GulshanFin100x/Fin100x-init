generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Advisor {
  id              String    @id @default(uuid())
  salutation      String
  firstName       String
  lastName        String
  designation     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  expertiseTags   String[]
  yearsExperience Int       @default(0)
  certificate     String
  fees            Float     @default(0)
  imageUrl        String
  email           String    @unique
  calendarId      String    @default("primary")
  meetings        Meeting[]
  reviews         Review[]
}

model Review {
  id        String   @id @default(uuid())
  rating    Float
  comment   String?
  advisorId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  advisor   Advisor  @relation(fields: [advisorId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([advisorId, userId])
}

model User {
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  id              String         @id @default(uuid())
  imageUrl       String?
  isNew           Boolean        @default(true)
  kycStatus       KycStatus      @default(none)
  language        String         @default("en-IN")
  name            String?
  phone           String         @unique
  phoneMasked     String
  referralCode    String?
  lastQuizTakenAt DateTime?
  redeemPoints    Int            @default(0)
  totalQuizzes    Int            @default(0)
  email           String?        @unique
  conversations   Conversation[]
  meetings        Meeting[]
  messages        Message[]
  reviews         Review[]
  session         Session?
  assets          UserAsset?
  financialData   FinancialData[]

  loanApplications LoanApplication[]
}

model UserAsset {
  id         String   @id @default(uuid())
  userId     String   @unique
  income     Float    @default(0)
  expenses   Float    @default(0)
  savings    Float    @default(0)
  netWorth   Float    @default(0)
  cashFlow   Float    @default(0)
  loans      Float    @default(0)
  insurance  Float    @default(0)
  taxSavings Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
}

model OTPRequest {
  id        String   @id
  phone     String
  otpHash   String
  deviceId  String?
  channel   String   @default("sms")
  locale    String   @default("en-IN")
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Session {
  id               String   @id @default(cuid())
  userId           String   @unique
  refreshTokenHash String
  deviceId         String?
  revoked          Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String    @id @default(uuid())
  title     String
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id               String       @id @default(uuid())
  conversationId   String
  message_query    String
  message_response String
  is_bot           Boolean      @default(false)
  is_encrypted     Boolean      @default(false)
  createdAt        DateTime     @default(now())
  userId           String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Quiz {
  id        Int        @id @default(autoincrement())
  title     String
  createdAt DateTime   @default(now())
  questions Question[]
}

model Question {
  id        Int      @id @default(autoincrement())
  quizId    Int
  text      String
  optionA   String
  optionB   String
  optionC   String
  optionD   String
  correct   String
  createdAt DateTime @default(now())
  quiz      Quiz     @relation(fields: [quizId], references: [id])
}

model Banner {
  id          String   @id @default(uuid())
  title       String
  imageUrl    String
  redirectUrl String
  screen      String
  validFrom   DateTime @default(now())
  validTill   DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GlossaryTerm {
  id         String   @id @default(uuid())
  tag        String
  word       String
  definition String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Meeting {
  id                 Int      @id @default(autoincrement())
  userId             String
  advisorId          String
  meetLink           String
  eventId            String
  startTime          DateTime
  endTime            DateTime
  conferenceRecordId String?
  transcript         String?
  createdAt          DateTime @default(now())
  advisor            Advisor  @relation(fields: [advisorId], references: [id])
  user               User     @relation(fields: [userId], references: [id])
}

model AgentSession {
  session_id String         @id @db.VarChar
  created_at DateTime       @default(now()) @db.Timestamp(6)
  updated_at DateTime       @default(now()) @db.Timestamp(6)
  messages   AgentMessage[]

  @@map("agent_sessions")
}

model AgentMessage {
  id           Int          @id @default(autoincrement())
  session_id   String       @db.VarChar
  message_data String
  created_at   DateTime     @default(now()) @db.Timestamp(6)
  session      AgentSession @relation(fields: [session_id], references: [session_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_id, created_at], map: "idx_agent_messages_session_time")
  @@map("agent_messages")
}

enum KycStatus {
  none
  pending
  verified
}

model FinancialData {
  id                   Int      @id @default(autoincrement())
  userId               String   
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

 monthlySavings       Int      @default(0)
  sipInvestments       Int      @default(0)
  totalAssets          Int      @default(0)
  totalLoans           Int      @default(0)
  monthlyEmi           Int      @default(0)
  creditCardOutstanding Int     @default(0)
  insuranceCoverage    Int      @default(0)
  taxSavings           Int      @default(0)
  retirementFund       Int      @default(0)
  monthlyIncome        Int      @default(0)
  monthlyExpenses      Int      @default(0)
  savingsRatio         Float     @default(0)
  score                Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Admin {
  id        String        @id @default(uuid())
  email     String        @unique
  password  String
  name      String?
  role      String        @default("admin") // could be "admin", "superadmin"
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  tokens    RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model BlacklistedToken {
  id        String    @id @default(uuid())
  token     String    @unique 
  expiresAt DateTime  
  createdAt DateTime  @default(now())
}


model Section {
  id          Int      @id @default(autoincrement())
  name        String
  startRule   Int       
  endRule     Int          
  rules       Rule[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Rule {
  id           Int      @id @default(autoincrement())
  sectionId    Int
  section      Section  @relation(fields: [sectionId], references: [id])
  number       Int      
  title        String 
  definition   String
  whyItMatters String
  howToApply   String
  example      String
  impact       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([sectionId, number])
}



// New added schema for Credit and Loans 

// ===== Enums (unchanged) =====
enum LoanCategory {
  PERSONAL_LOAN
  HOME_LOAN
  AUTO_LOAN
  BUSINESS_LOAN
  EDUCATION_LOAN
  GOLD_LOAN
  CREDIT_CARD
  OTHER
}

enum AuthType {
  OAUTH2
  API_KEY
  BEARER_TOKEN
  BASIC_AUTH
  CUSTOM
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_INFO_REQUIRED
  APPROVED
  REJECTED
  DISBURSED
  CLOSED
  CANCELLED
}

enum TransactionType {
  DISBURSEMENT
  EMI_PAYMENT
  PREPAYMENT
  LATE_FEE
  PROCESSING_FEE
  OTHER_CHARGE
}

// ===== Models (fixed relations + defaults for arrays) =====

model LoanProvider {
  id                    String    @id @default(uuid())
  name                  String    @unique
  displayName           String
  code                  String    @unique
  category              LoanCategory
  logoUrl               String?
  description           String?

  // API Configuration
  apiBaseUrl            String
  apiVersion            String    @default("v1")
  authType              AuthType
  authConfig            Json

  // Provider-specific settings
  maxLoanAmount         Float?
  minLoanAmount         Float?
  minCreditScore        Int?
  supportedTenures      Int[]     @default([])    // default empty array
  interestRateRange     String?
  processingFee         Float?

  // Feature flags
  isActive              Boolean   @default(true)
  supportsInstantApproval Boolean @default(false)
  supportsEmi           Boolean   @default(true)
  supportsTopup         Boolean   @default(false)
  requiresKyc           Boolean   @default(true)

  // Rate limiting
  rateLimit             Int       @default(100)
  timeout               Int       @default(30000)

  // Webhook configuration
  webhookUrl            String?
  webhookSecret         String?
  webhookEvents         String[]   @default([])    // default empty array

  // Priority and ranking
  priority              Int       @default(0)

  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime? @updatedAt

   providerForm     ProviderForm?

  // Relations (no explicit @relation on the list side)
  fieldMappings         ProviderFieldMapping[]
  applications          LoanApplication[]
  apiLogs               ProviderApiLog[]
  webhookLogs           ProviderWebhookLog[]

  @@index([category])
  @@index([isActive])
  @@index([priority])
}

model ProviderFieldMapping {
  id             String   @id @default(uuid())
  providerId     String
  internalField  String
  providerField  String
  fieldType      String
  transformRule  Json?    // JSON defining transformations
  isRequired     Boolean  @default(false)
  defaultValue   String?
  validationRule Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // referencing side: onDelete cascade set here
  provider       LoanProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, internalField])
  @@index([providerId])
}

model LoanApplication {
  id                    String     @id @default(uuid())
  userId                String
  providerId            String
  applicationNumber     String     @unique
  providerApplicationId String?
  loanType              LoanCategory
  loanAmount            Float
  tenure                Int
  interestRate          Float?
  monthlyEmi            Float?
  processingFee         Float?

  status                ApplicationStatus @default(DRAFT)
  statusMessage         String?
  subStatus             String?

  applicantData         Json
  providerRequestData   Json?
  providerResponseData  Json?

  submittedAt           DateTime?
  approvedAt            DateTime?
  disbursedAt           DateTime?
  rejectedAt            DateTime?

  lastSyncedAt          DateTime?
  syncAttempts          Int       @default(0)
  syncErrors            Json?
  metadata              Json?
  tags                  String[]  @default([])   // default empty array

  createdAt             DateTime  @default(now())
  updatedAt             DateTime? @updatedAt

  // referencing side: provider and user fields with onDelete where required
  provider              LoanProvider   @relation(fields: [providerId], references: [id])
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  documents             ApplicationDocument[]
  statusHistory         ApplicationStatusHistory[]
  transactions          LoanTransaction[]
  apiLogs               ProviderApiLog[]
  webhookLogs           ProviderWebhookLog[]

  @@index([userId, status])
  @@index([providerId, status])
  @@index([applicationNumber])
  @@index([providerId])
}

model ApplicationDocument {
  id                 String   @id @default(uuid())
  applicationId      String
  documentType       String
  documentName       String
  documentUrl        String
  fileSize           Int?
  mimeType           String?
  uploadedToProvider Boolean  @default(false)
  providerDocumentId  String?
  isVerified         Boolean  @default(false)
  verifiedAt         DateTime?
  verificationData   Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime? @updatedAt

  application        LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, documentType])
  @@index([applicationId])
}

model ApplicationStatusHistory {
  id                String            @id @default(uuid())
  applicationId     String
  fromStatus        ApplicationStatus
  toStatus          ApplicationStatus
  statusMessage     String?
  changedBy         String?
  providerResponse  Json?
  createdAt         DateTime          @default(now())

  application       LoanApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([applicationId])
}

model LoanTransaction {
  id              String      @id @default(uuid())
  applicationId   String
  transactionType TransactionType
  amount          Float
  transactionDate DateTime
  dueDate         DateTime?
  status          String
  providerTxnId   String?
  providerResponse Json?
  description     String?
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime?   @updatedAt

  application     LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, transactionDate])
  @@index([applicationId])
  @@index([status])
}

model ProviderApiLog {
  id              String   @id @default(uuid())
  providerId      String
  applicationId   String?
  endpoint        String
  method          String
  requestHeaders  Json?
  requestBody     Json?
  responseStatus  Int?
  responseBody    Json?
  responseTime    Int?
  success         Boolean
  errorMessage    String?
  createdAt       DateTime @default(now())

  provider        LoanProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  application     LoanApplication? @relation(fields: [applicationId], references: [id])

  @@index([providerId, createdAt])
  @@index([applicationId, createdAt])
  @@index([providerId])
}

model ProviderWebhookLog {
  id              String   @id @default(uuid())
  providerId      String
  event           String
  payload         Json
  headers         Json?
  processed       Boolean  @default(false)
  processedAt     DateTime?
  processingError String?
  applicationId   String?
  createdAt       DateTime @default(now())

  provider        LoanProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  application     LoanApplication? @relation(fields: [applicationId], references: [id])

  @@index([providerId, createdAt])
  @@index([applicationId])
  @@index([processed])
  @@index([providerId])
}



/// ProviderForm: stores UI form config for a LoanProvider (one-to-one)
model ProviderForm {
  id            String   @id @default(uuid())
  providerId    String   @unique
  formId        String   // e.g. "loan-application-v1" or "user-registration"
  title         String?
  description   String?
  fields        Json     // array of field objects (your UI shape)
  submitButton  Json?    // optional { text, loadingText, ... }
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  provider      LoanProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}